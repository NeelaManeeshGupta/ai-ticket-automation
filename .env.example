# Application Settings
PROJECT_NAME="SAP Support AI Automation Backend"
LOG_LEVEL="INFO"
ENVIRONMENT="development"

# Database Configuration (SQLite by default, configurable to PostgreSQL)
DATABASE_URL="sqlite:///./sap_tickets.db"

# Mock Engine Configuration (Enable for local testing without external API credentials)
USE_MOCK_GMAIL=true
USE_MOCK_LLM=true

# AI / LLM Configuration
GEMINI_API_KEY=""

# Gmail API Configuration
GMAIL_CREDENTIALS_FILE="gmail/credentials.json"
GMAIL_TOKEN_FILE="gmail/token.json"

# Storage Directories
UPLOAD_DIR="uploads"

# Background Polling & Webhook Settings
ENABLE_BACKGROUND_POLLING=false
EMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_PUBSUB_TOPIC="projects/YOUR_PROJECT_ID/topics/gmail-notifications"
WEBHOOK_SECRET_TOKEN="sap-ai-webhook-secret"
